    <string name="onboarding_accessibility_action">Open accessibility settings</string>
    <string name="onboarding_accessibility_restricted_hint">Come back here — Android blocks this until you allow it once, in this app\'s own App info page:</string>
    <string name="onboarding_accessibility_restricted_steps">1. Tap "Open app info" below\n2. Tap the ⋮ menu (top right)\n3. Tap "Allow restricted settings"\n4. Go back to Accessibility and turn DroidThumb on</string>
    <string name="onboarding_accessibility_restricted_action">Open app info</string>
